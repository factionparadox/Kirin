#!/usr/bin/env python3
"""Stub unsquashfs: -s prints superblock info, -d unpacks a fake openKylin root."""
import os, sys
from pathlib import Path
a = sys.argv[1:]
def complete(path):
    data = Path(path).read_bytes()
    return data[:4] == b'hsqs' and len(data) >= int.from_bytes(data[40:48], 'little')
if a[0] == '-s':
    if not complete(a[1]):
        print('Read on filesystem failed because EOF\nFATAL ERROR: File system corruption detected'); sys.exit(1)
    print('Found a valid SQUASHFS 4:0 superblock\nCompression xz\nBlock size 131072'); sys.exit(0)
if a[0] == '-d':
    r = Path(a[1]); assert not r.exists(); assert a[2].endswith('filesystem.squashfs'), a[2]
    assert Path(a[2]).read_bytes() == Path(os.environ['MOCK_STATE'], 'squashfs.full').read_bytes(), 'unpacking a damaged squashfs'
    for d in ('var/lib/dpkg/info', 'opt/kylin-ai', 'etc', 'usr/sbin', 'usr/share/applications', 'run/systemd/resolve'):
        (r / d).mkdir(parents=True, exist_ok=True)
    pk = ['apt', 'dpkg', 'kylin-ai', 'openkylin-token-center', 'openkylin-desktop-meta', 'kylin-id', 'wps-office']
    (r / 'var/lib/dpkg/status').write_text(''.join(f'Package: {p}\nStatus: install ok installed\nVersion: 1\n\n' for p in pk))
    (r / 'var/lib/dpkg/info/kylin-ai.list').write_text('/opt/kylin-ai/asr.onnx\n')
    (r / 'opt/kylin-ai/asr.onnx').write_bytes(os.urandom(8192))
    (r / 'var/opt/kingsoft/addons').mkdir(parents=True)
    (r / 'var/opt/kingsoft/addons/text_detect.tflite').write_bytes(os.urandom(8192))
    (r / 'etc/bash.bashrc').write_text('# bashrc\n')
    (r / 'usr/share/glib-2.0/schemas').mkdir(parents=True)
    (r / 'usr/share/glib-2.0/schemas/org.ukui.background.gschema.xml').write_text(
        '<schemalist><schema id="org.ukui.background"><key name="picture-filename" type="s">'
        "<default>'/usr/share/backgrounds/openkylin.jpg'</default></key></schema></schemalist>")
    (r / 'etc/hostname').write_text('localhost.localdomain\n')
    (r / 'usr/share/applications/files.desktop').write_text('[Desktop Entry]\nName=Files\n')
    (r / 'usr/share/applications/kylin-music.desktop').write_text('[Desktop Entry]\nName=Kylin Music\nExec=kylin-music\n')
    (r / 'usr/lib').mkdir(parents=True, exist_ok=True)
    (r / 'usr/lib/os-release').write_text('NAME="openKylin"\nID=openkylin\nVERSION_ID="3.0"\n')
    os.symlink('../usr/lib/os-release', r / 'etc/os-release')
    os.symlink('../run/systemd/resolve/stub-resolv.conf', r / 'etc/resolv.conf')
    # openKylin's graphical installer: a swap setting and a Chinese fallback message.
    (r / 'usr/share/kylin-os-installer/scripts/prepare').mkdir(parents=True)
    I = r / 'usr/share/kylin-os-installer'
    for d in ('data', 'scripts/in_chroot'): (I / d).mkdir(parents=True, exist_ok=True)
    (r / 'var/log/installer').mkdir(parents=True)
    cfg = '[config]\nenable-swapfile=false\n[custompartition]\ncustom-partitions="efi;boot;root;backup;data;swap;"\n'
    (I / 'ky-installer.cfg').write_text(cfg); (r / 'var/log/installer/ky-installer.cfg').write_text(cfg)
    for f in ('data/systemdatasize.sh', 'scripts/autopart.sh', 'scripts/autopart-efi.sh'):
        (I / f).write_text('systemd-detect-virt || do_backup_size\n### swap\nswap=$(( ram * 12 / 1024 / 10 ))\n')
    (I / 'scripts/utils').write_text('readonly virtual_machine=$(get_value virtual-machine)\n')
    (I / 'scripts/prepare/18setup-swapfile').write_text('#!/bin/bash\n\nset -e\n\nswapfile=8192\n')
    (I / 'scripts/in_chroot/genfstab').write_text("    [[ $device = *'\\040(deleted)' ]] && continue\n")
    (r / 'usr/share/kylin-os-installer/scripts/prepare/16copy-basic-filesystem').write_text(
        "case ${LANGUAGES} in\n'en_US')\necho Done\n;;\n*)\necho 完成\n;;\nesac\nmsg \"文件系统拷贝完成\"\n")
    # openKylin's OSTree repository and the kernel its installer deploys.
    (r / 'boot').mkdir(); (r / 'usr/lib/modules/7.0.0-3-generic').mkdir(parents=True)
    (r / 'boot/vmlinuz-7.0.0-3-generic').write_bytes(b'kernel'); (r / 'boot/initrd.img-7.0.0-3-generic').write_bytes(b'initrd')
    branch = 'openkylin/desktop/v3.0/community/general/all/release/amd64'
    (r / 'etc/ostree-release').write_text(f'[openkylin]\nversion=openkylin:{branch}\nupdate-type=full\n')
    repo = r / 'sysroot/ostree/repo'
    (repo / 'refs/remotes/openkylin' / branch).parent.mkdir(parents=True)
    (repo / 'config').write_text('[core]\nmode=bare\n')
    (repo / 'refs/remotes/openkylin' / branch).write_text('7abfcb4c' + '0' * 56 + '\n')
    sys.exit(0)
sys.exit(f'unsquashfs stub: unhandled {a}')
