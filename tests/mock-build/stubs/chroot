#!/usr/bin/env python3
"""Stub chroot: emulates build/chroot-steps.sh against the fake dpkg status."""
import os, re, sys
from pathlib import Path
root, script, step, *args = sys.argv[1:]
root = Path(root)
assert '/usr/sbin' in os.environ['PATH'].split(':'), 'chroot run without sbin in PATH'
assert script == '/kirin-build/chroot-steps.sh' and (root / 'kirin-build/IN_CHROOT').is_file(), 'chroot not prepared'
assert (root / 'usr/sbin/policy-rc.d').is_file(), 'services not blocked'
status = root / 'var/lib/dpkg/status'
pkgs = re.findall(r'^Package: (\S+)', status.read_text(), re.M)
extra = (Path(os.environ['MOCK_STATE']) / 'extra-removal').exists()
def write(names): status.write_text(''.join(f'Package: {p}\nStatus: install ok installed\nVersion: 1\n\n' for p in names))
if step == 'installed':
    print('\n'.join(p for p in args if p in pkgs))
elif step == 'install':
    assert (root / 'kirin-build/libfyaml-0.9.6.tar.gz').is_file(), 'libfyaml source not staged'
    lst = (root / 'kirin-build/base-packages.txt').read_text()
    want = [l.strip() for l in lst.splitlines() if l.strip() and not l.startswith('#')] + ['locales']
    write(pkgs + [p for p in want if p not in pkgs])
elif step == 'simulate-purge':
    for p in args: print(f'Purg {p} [1]')
    if extra: print('Remv openkylin-desktop-meta [1]')
elif step == 'purge':
    gone = set(args) | ({'openkylin-desktop-meta'} if extra else set())
    for p in gone:   # like dpkg: remove the package's files
        lst = root / 'var/lib/dpkg/info' / f'{p}.list'
        if lst.is_file():
            for f in lst.read_text().split():
                (root / f.lstrip('/')).unlink(missing_ok=True)
    write([p for p in pkgs if p not in gone])
elif step == 'flatpak':
    for app in ('io.github.flattool.Warehouse', 'com.github.tchx84.Flatseal'):
        (root / 'var/lib/flatpak/app' / app / 'x86_64/stable').mkdir(parents=True, exist_ok=True)
        e = root / 'var/lib/flatpak/exports/share/applications' / f'{app}.desktop'
        e.parent.mkdir(parents=True, exist_ok=True); e.write_text('[Desktop Entry]\nName=App\n')
elif step == 'finish':
    assert (root / 'usr/share/ollama/.ollama/models').is_dir()
elif step == 'extra-repos':
    assert (root / 'kirin-build/extra-repos/kirin-debian.gpg').is_file(), 'Debian keyring not staged'
    print('ENABLED debian (pinned below openKylin)')
elif step == 'install-extras':
    assert (root / 'kirin-build/extra-packages.txt').is_file(), 'extra package list not staged'
    print('installed fastfetch from 2.0 http://archive.ubuntu.com/ubuntu')
elif step == 'zfs':
    k = root / 'lib/modules/7.0.0-3-generic/updates/dkms'; k.mkdir(parents=True, exist_ok=True)
    (k / 'zfs.ko.zst').write_bytes(b'module')
    for tool in ('zpool', 'zfs'):
        t = root / 'usr/sbin' / tool; t.write_text('#!/bin/sh\n'); t.chmod(0o755)
    print('ZFS_MODULE 7.0.0-3-generic'); print('ZFS: OpenZFS 2.4.1 ready (zfs-2.4.1)')
elif step == 'pin-extras':
    print('from Ubuntu: fprintd'); print('1 packages from the extra repositories pinned for updates')
elif step == 'prefer-ubuntu':
    assert (root / 'kirin-build/prefer-ubuntu.txt').is_file(), 'prefer-ubuntu list not staged'
    print('UBUNTU alsa-ucm-conf 1.2.15-1ubuntu1 (openKylin had 1.2.14-ok1)')
elif step == 'cleanup-removed':
    if 'wps-office' not in pkgs:
        import shutil; shutil.rmtree(root / 'var/opt/kingsoft', ignore_errors=True); print('removed leftover /var/opt/kingsoft')
elif step == 'kirin-debs':
    specs = root / 'kirin-build/debs'
    assert (root / 'kirin-build/build-debs.py').is_file() and any(specs.glob('*/spec.json')), 'Kirin package specs not staged'
    print('installed: ani-cli_test_all.deb')
elif step == 'proton':
    print('NOT AVAILABLE: Proton pass')
elif step == 'manifest':
    print('\n'.join(f'{p}\t1' for p in pkgs))
else:
    sys.exit(f'chroot stub: unknown step {step}')
