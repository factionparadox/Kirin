// Kirin Linux system-wide Fastfetch configuration (users can override it in ~/.config/fastfetch).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kirin/branding/fastfetch-logo.txt",
    "color": { "1": "38;5;24", "2": "38;5;25", "3": "38;5;31", "4": "38;5;32", "5": "38;5;39", "6": "38;5;117" },
    "padding": { "top": 1, "right": 2 }
  },
  "display": { "color": { "keys": "38;5;39", "title": "38;5;117" } },
  "modules": [
    "title",
    "separator",
    { "type": "os", "format": "Kirin Linux (openKylin {version-id} base) {arch}" },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "locale",
    "break",
    "colors"
  ]
}
