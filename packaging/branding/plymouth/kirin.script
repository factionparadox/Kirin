# Kirin Linux boot splash: the Kirin logo, gently pulsing, on a dark background.
# Also handles disk-encryption passwords and boot messages.

Window.SetBackgroundTopColor(0.07, 0.09, 0.13);
Window.SetBackgroundBottomColor(0.04, 0.05, 0.08);

logo.original = Image("splash.png");
scale = Math.Min(Window.GetWidth() * 0.35 / logo.original.GetWidth(),
                 Window.GetHeight() * 0.45 / logo.original.GetHeight());
if (scale > 1) scale = 1;
logo.image = logo.original.Scale(logo.original.GetWidth() * scale, logo.original.GetHeight() * scale);
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.8 + 0.2 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Password prompt (e.g. an encrypted disk)
fun display_password_callback(prompt, bullets) {
    prompt_text.sprite = Sprite(Image.Text(prompt, 0.85, 0.9, 1));
    prompt_text.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - prompt_text.sprite.GetImage().GetWidth() / 2,
                                   logo.y + logo.image.GetHeight() + 30, 2);
    stars = "";
    for (i = 0; i < bullets; i++) stars += "*";
    bullets_text.sprite = Sprite(Image.Text(stars, 1, 1, 1));
    bullets_text.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bullets_text.sprite.GetImage().GetWidth() / 2,
                                    logo.y + logo.image.GetHeight() + 60, 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_text.sprite = NULL;
    bullets_text.sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
    message.sprite = Sprite(Image.Text(text, 0.6, 0.7, 0.8));
    message.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - message.sprite.GetImage().GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() - 50, 2);
}
Plymouth.SetMessageFunction(message_callback);
